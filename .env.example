# Copie para .env (nunca faça commit do .env) ou cadastre como segredos do ambiente na nuvem.
IQ_EMAIL=seu@email.com
IQ_PASSWORD=sua_senha
# demo = conta de treino (padrão). real = dinheiro de verdade.
IQ_MODE=demo
# Valor máximo por operação e número máximo de operações por execução.
IQ_MAX_STAKE=5
IQ_MAX_TRADES=10
# false para ver o navegador (só funciona com tela)
IQ_HEADLESS=true
